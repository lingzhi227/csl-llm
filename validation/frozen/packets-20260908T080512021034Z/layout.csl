const memcpy=@import_module("<memcpy/get_params>",.{.width=4,.height=3});layout{@set_rectangle(4,3);for(@range(i16,4))|x|{for(@range(i16,3))|y|{@set_tile_code(x,y,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.role=if(x==0 and y==0) @as(u16,0) else if(x==3 and y==2) @as(u16,1) else @as(u16,2)});}}@export_name("control",[*]u32,false);@export_name("progress",[*]u32,false);@export_name("history",[*]u32,false);@export_name("lengths",[*]u32,false);@export_name("initialize",fn()void);@export_name("reset",fn()void);@export_name("run",fn()void);}
