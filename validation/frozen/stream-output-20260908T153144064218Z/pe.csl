// Tagged output transport diagnostic. No model or neural arithmetic.
param memcpy_params;
param root:bool;
param width:i16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const placement=@import_module("<layout>");
const queue=@get_output_queue(5);
const callback=@get_local_task_id(14);
const destination=@get_dsr(dsr_dest,5);const source=@get_dsr(dsr_src1,5);
var output=@zeros([128]u32);var progress=@zeros([1]u32);var sending:bool=false;
fn prepare(tag:i16) void {
 @assert(!sending and tag>0 and tag<128);
 const base=(@as(u32,tag)<<24)|(@as(u32,placement.get_y_coord())<<16)|(@as(u32,placement.get_x_coord())<<8);
 for(@range(u16,128))|i|{output[i]=base|@as(u32,i);}
 progress[0]=0;sys.unblock_cmd_stream();
}
fn export_output(column:i16) void {
 @assert(!sending and column>=0 and column<width and column%8==0);
 if(comptime root){
  if(placement.get_x_coord()==@as(u16,column)){
   sending=true;
   const mem=@get_dsd(mem1d_dsd,.{.base_address=&output,.extent=128});
   const out=@get_dsd(fabout_dsd,.{.output_queue=queue,.extent=128});
   @load_to_dsr(destination,out,.{.async=true,.activate=callback});@load_to_dsr(source,mem);
   @mov32(destination,source,.{.async=true});return;
  }
 }
 progress[0]+=1;sys.unblock_cmd_stream();
}
task finished() void {
 @assert(sending);sending=false;progress[0]+=1;sys.unblock_cmd_stream();
}
const pp:[*]u32=&progress;
comptime {
 @initialize_queue(queue,.{.color=@get_color(@bitcast(u16,sys.MEMCPYD2H_1))});
 @bind_local_task(finished,callback);
 @export_symbol(pp,"progress");@export_symbol(prepare);@export_symbol(export_output);
}
