// Device-only batch1 token metadata. No tokenizer, logits or neural arithmetic.
// EOS defaults are pinned Qwen2.5-0.5B-Instruct generation_config values.
param context_capacity:u16=2048;param generation_capacity:u16=256;
param eos_first:u32=151645;param eos_second:u32=151643;
comptime{@comptime_assert(context_capacity>0 and context_capacity<=2048 and generation_capacity>0 and generation_capacity<=256);}
var prompt=@zeros([context_capacity]u32);
var generated=@zeros([generation_capacity]u32);
var prompt_length:u16=0;var generation_limit:u16=0;
var consumed:u16=0;var generated_count:u16=0;
var busy:bool=false;var finished:bool=true;var head_expected:bool=false;
// 0running,1generation limit,2EOS,3prefill-only completed.
var reason:u16=0;

// Caller loads prompt IDs and joins previous work before reset. SRAM outside
// active lengths is deliberately not cleared and must never become visible.
fn reset(length:u16,limit:u16) void {
 @assert(!busy and length>0 and length<=context_capacity and limit<=generation_capacity);
 @assert(@as(u32,length)+@as(u32,limit)<=@as(u32,context_capacity));
 for(@range(u16,length))|i|{@assert(prompt[i]<151936);}
 prompt_length=length;generation_limit=limit;consumed=0;generated_count=0;
 head_expected=false;finished=false;reason=0;
}
// Returned token is original prompt data or the previously selected device
// winner. The caller must not call start again until completing this step.
fn start() u32 {
 @assert(!busy and !finished and consumed<context_capacity);
 busy=true;head_expected=consumed+1>=prompt_length and generation_limit>0;
 if(consumed<prompt_length){return prompt[consumed];}
 @assert(generated_count>0);return generated[generated_count-1];
}
fn complete_prefill() void {
 @assert(busy and !head_expected and consumed<prompt_length);
 consumed+=1;busy=false;
 if(consumed==prompt_length){@assert(generation_limit==0);finished=true;reason=3;}
}
fn complete_head(winner:u32) void {
 @assert(busy and head_expected and winner<151936 and generated_count<generation_limit);
 generated[generated_count]=winner;generated_count+=1;consumed+=1;busy=false;
 if(winner==eos_first or winner==eos_second){finished=true;reason=2;}
 else if(generated_count==generation_limit){finished=true;reason=1;}
}
