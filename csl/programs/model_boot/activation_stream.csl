// Framing state for one resident layer boundary on packets.csl. No owned
// queues, tasks, DSRs or activation buffer. Caller supplies those resources.
// The packet adapter guarantees each source send stays owned until on_sent.
param length:u16=896;
param kind:u16=65535;
comptime{@comptime_assert(length>0);}
var invocation:u32=0;
var received_count:u16=0;
var sent_count:u16=0;
var pending_count:u16=0;
var command:bool=false;
var started:bool=false;
var sending:bool=false;

// Caller must establish a global completion barrier before reusing a frame.
fn reset(epoch:u32) void {
 @assert(!sending and epoch>0 and epoch<=65535);
 invocation=epoch;received_count=0;sent_count=0;pending_count=0;
 command=false;started=false;
}
fn arm() void {@assert(!command);command=true;}
// Validate before the caller copies payload into its existing input buffer.
fn accept(data:[*]u32,count:u16) u16 {
 @assert(count>=3 and count<=31 and !started);
 @assert((data[0]>>16)==invocation and @as(u16,data[0]&0xffff)==kind);
 @assert(data[1]==@as(u32,received_count));
 const n=count-2;@assert(n<=length-received_count);
 const offset=received_count;received_count+=n;return offset;
}
// Both command arrival and packet arrival call this join after copying data.
fn take_ready() bool {
 if(command and received_count==length and !started){started=true;return true;}
 return false;
}
// Caller assembles payload and sends count+2 words from its existing tx buffer.
fn frame(header:[*]u32) u16 {
 @assert(!sending and sent_count<length);
 pending_count=if(length-sent_count<29) length-sent_count else 29;
 header[0]=(invocation<<16)|@as(u32,kind);header[1]=@as(u32,sent_count);
 sending=true;return pending_count;
}
fn complete_send() bool {
 @assert(sending);sent_count+=pending_count;pending_count=0;sending=false;
 return sent_count==length;
}
