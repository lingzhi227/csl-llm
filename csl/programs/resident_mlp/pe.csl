// Native Qwen MLP candidate. Qualification status belongs to immutable evidence.
// Roles: 0 guard, 1 UP, 2 GATE, 3 DOWN, 4 controller.
param memcpy_params;
param role:u16;
param group:u16;
param ordinal:u16;
param participants:u16;
param negative:direction;
param positive:direction;
param destination_x:u16;
param destination_y:u16;
param static_weights:bool=false;
param weight_file="<empty>";
const matrix=role>=1 and role<=3;
const root=matrix and ordinal==0;
const controller=role==4;
const gate_root=role==2 and root;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const clock=@import_module("<time>");
const kernel=@import_module(if(matrix) "kernel.csl" else "<empty>",if(matrix) .{.rows=128,.columns=112} else .{});
const vector=@import_module(if(gate_root) "vector.csl" else "<empty>",if(gate_root) .{.length=128} else .{});
const line=@import_module(if(matrix) "line.csl" else "<empty>",if(matrix) .{.ordinal=ordinal,.participants=participants,.length=128,.negative=negative,.positive=positive,.colors=[3]color{@get_color(0),@get_color(1),@get_color(2)},.task_id=@get_local_task_id(10),.on_complete=reduced} else .{});
const input_task=@get_local_task_id(11);
const receiver=@import_module(if(matrix) "input.csl" else "<empty>",if(matrix) .{.length=112,.input_color=@get_color(if(role==3) 4 else 3),.completion_task=input_task} else .{});
const packets=@import_module("packets.csl",.{.sent_task_id=@get_local_task_id(12),.received_task_id=@get_local_task_id(13),.on_sent=sent,.on_received=received});
const initial_weights=@import_module(weight_file);
var weights=if(static_weights and matrix) initial_weights.values else @zeros([if(matrix) 7168 else 1]u32);
var input=@zeros([if(controller) 896 else 112]f32);
var partial=@zeros([if(matrix) 128 else 1]f32);
var result=@zeros([if(matrix) 128 else 1]f32);
var up=@zeros([if(gate_root) 128 else 1]f32);
var activation=@zeros([if(controller) 4928 else 1]f32);
var output=@zeros([if(controller) 896 else 1]f32);
var counts=@zeros([if(controller) 38 else 1]u16);
var tx=@zeros([31]u32);
var epoch:u32=0;
var progress=@zeros([1]u32);
var timing=@zeros([6]u16);
var started=@zeros([3]u16);
var ended=@zeros([3]u16);
var up_count:u16=0;
var complete_groups:u16=0;
var tx_offset:u16=0;
var tx_count:u16=0;
var line_ready:bool=false;
var activated:bool=false;
var command_waiting:bool=false;
var input_sent:bool=false;
var down_started:bool=false;
var down_sent:bool=false;
const dest=@get_dsr(dsr_dest,5);
const source=@get_dsr(dsr_src1,5);
const initial_queue=@get_output_queue(4);
const down_queue=@get_output_queue(5);

fn initialize() void {packets.init();sys.unblock_cmd_stream();}
// Host observes every PE's ready value before launching compute. This is only
// an invocation boundary; no intermediate neural values leave the device.
fn prepare() void {
 @assert(!packets.sending and !packets.receiving);
 epoch+=1;up_count=0;complete_groups=0;tx_offset=0;line_ready=false;
 activated=false;command_waiting=false;input_sent=false;down_started=false;down_sent=false;
 if(comptime controller){for(@range(u16,38))|i|{counts[i]=0;}}
 progress[0]=epoch*2-1;sys.unblock_cmd_stream();
}
fn finish() void {
 clock.get_timestamp(&ended);clock.disable_tsc();
 for(@range(u16,3))|i|{timing[i]=started[i];timing[i+3]=ended[i];}
 progress[0]=epoch*2;command_waiting=false;sys.unblock_cmd_stream();
}
fn compute() void {
 clock.enable_tsc();clock.get_timestamp(&started);command_waiting=true;
 if(comptime controller){
  const mem=@get_dsd(mem1d_dsd,.{.base_address=&input,.extent=896});
  const out=@get_dsd(fabout_dsd,.{.output_queue=initial_queue,.extent=896});
  @load_to_dsr(dest,out,.{.async=true,.activate=input_task});@load_to_dsr(source,mem);@mov32(dest,source,.{.async=true});
 }else if(comptime matrix){receiver.arm(&input);}else{finish();}
}
task input_complete() void {
 if(comptime matrix){kernel.compute(@ptrcast([*]u16,&weights),&input,&partial);line.start(&partial,&result);}
 else if(comptime controller){
  if(!down_started){input_sent=true;start_down();}else{down_sent=true;finish_controller();}
 }
}
fn reduced() void {
 if(comptime root){
  if(comptime gate_root){line_ready=true;activate_gate();}else{transmit();}
 }else{finish();}
}
fn activate_gate() void {
 if(comptime gate_root){
  if(line_ready and up_count==128 and !activated){
   activated=true;vector.swiglu(&result,&up,&partial);transmit();
  }
 }
}
fn transmit() void {
 if(comptime root){
  @assert(tx_offset<128);tx_count=if(128-tx_offset<29) 128-tx_offset else 29;
  tx[0]=(epoch<<16)|@as(u32,group);tx[1]=@as(u32,tx_offset);
  for(@range(u16,29))|i|{if(i<tx_count){tx[2+i]=@bitcast(u32,if(gate_root) partial[tx_offset+i] else result[tx_offset+i]);}}
  packets.send(destination_x,destination_y,&tx,tx_count+2);
 }
}
fn sent() void {
 @assert(root);tx_offset+=tx_count;
 if(tx_offset<128){transmit();}else{finish();}
}
fn received(data:[*]u32,length:u16) void {
 @assert(length>=3 and length<=31 and (data[0]>>16)==epoch);
 const owner=@as(u16,data[0]&0xffff);const begin=@as(u16,data[1]);const n=length-2;
 @assert(begin+n<=128);
 if(comptime gate_root){
  @assert(owner==group and begin==up_count);
  for(@range(u16,29))|i|{if(i<n){up[begin+i]=@bitcast(f32,data[2+i]);}}
  up_count+=n;activate_gate();
 }else if(comptime controller){
  @assert(owner<(if(down_started) 7 else 38) and begin==counts[owner]);
  for(@range(u16,29))|i|{if(i<n){
   if(down_started){output[owner*128+begin+i]=@bitcast(f32,data[2+i]);}
   else{activation[owner*128+begin+i]=@bitcast(f32,data[2+i]);}
  }}
  counts[owner]+=n;if(counts[owner]==128){complete_groups+=1;}
  if(down_started){finish_controller();}else{start_down();}
 }else{@assert(false);}
}
fn start_down() void {
 if(comptime controller){
  // DSR5's initial send and all gate payloads must both complete first.
  if(input_sent and complete_groups==38 and !down_started){
   down_started=true;complete_groups=0;
   for(@range(u16,38))|i|{counts[i]=0;}
   const mem=@get_dsd(mem1d_dsd,.{.base_address=&activation,.extent=4928});
   const out=@get_dsd(fabout_dsd,.{.output_queue=down_queue,.extent=4928});
   @load_to_dsr(dest,out,.{.async=true,.activate=input_task});@load_to_dsr(source,mem);@mov32(dest,source,.{.async=true});
  }
 }
}
fn finish_controller() void {
 if(comptime controller){if(command_waiting and down_sent and complete_groups==7){finish();}}
}
const wp:[*]u32=&weights;const ip:[*]f32=&input;const rp:[*]f32=&result;
const ap:[*]f32=&activation;const op:[*]f32=&output;const pp:[*]u32=&progress;const tp:[*]u16=&timing;
comptime {
 if(controller){@initialize_queue(initial_queue,.{.color=@get_color(3)});@initialize_queue(down_queue,.{.color=@get_color(4)});}
 @bind_local_task(input_complete,input_task);
 @export_symbol(wp,"weights");@export_symbol(ip,"input");@export_symbol(rp,"result");@export_symbol(ap,"activation");@export_symbol(op,"output");@export_symbol(pp,"progress");@export_symbol(tp,"timing");
 @export_symbol(initialize);@export_symbol(prepare);@export_symbol(compute);
}
