const memcpy=@import_module("<memcpy/get_params>",.{.width=2,.height=1});
layout{
 @set_rectangle(2,1);
 for(@range(i16,2))|x|{@set_tile_code(x,0,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.role=@as(u16,x)});}
 @export_name("control",[*]u32,false);@export_name("status",[*]u32,false);
 @export_name("value",[*]u32,false);@export_name("wire",[*]u32,false);
 @export_name("last_payload",[*]u32,false);
 @export_name("initialize",fn()void);@export_name("setup",fn()void);@export_name("work",fn()void);
}
